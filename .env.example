# PostgreSQL
DB_URL=postgresql+asyncpg://matryoshka:matryoshka_pass@localhost:5432/matryoshka_db
POSTGRES_USER=matryoshka
POSTGRES_PASSWORD=matryoshka_pass
POSTGRES_DB=matryoshka_db

# OpenRouter AI (Strict Zero Secrets rule: put your real key here locally)
OPENROUTER_API_KEY=your_openrouter_api_key_here
OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct

# Ports
ENTERPRISE_REST_PORT=8001
ENTERPRISE_GRPC_PORT=50051
REGULATOR_REST_PORT=8002
REGULATOR_GRPC_PORT=50052
ANALYTICS_REST_PORT=8003
ANALYTICS_GRPC_PORT=50053
CLICKHOUSE_HTTP_PORT=8123
CLICKHOUSE_TCP_PORT=9000
FRONTEND_PORT=3000

# ClickHouse OLAP
CLICKHOUSE_HOST=clickhouse
CLICKHOUSE_PORT=8123
CLICKHOUSE_DB=matryoshka_analytics
CLICKHOUSE_USER=default
CLICKHOUSE_PASSWORD=
