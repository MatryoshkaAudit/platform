# PostgreSQL
DB_URL=postgresql+asyncpg://matryoshka:matryoshka_pass@localhost:5432/matryoshka_db
POSTGRES_USER=matryoshka
POSTGRES_PASSWORD=matryoshka_pass
POSTGRES_DB=matryoshka_db

# OpenRouter AI (Strict Zero Secrets rule: put your real key here locally)
OPENROUTER_API_KEY=your_openrouter_api_key_here
OPENROUTER_MODEL=anthropic/claude-3.5-sonnet

# Ports
ENTERPRISE_REST_PORT=8001
ENTERPRISE_GRPC_PORT=50051
REGULATOR_REST_PORT=8002
REGULATOR_GRPC_PORT=50052
FRONTEND_PORT=3000
